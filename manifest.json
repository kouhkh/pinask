{
  "manifest_version": 3,
  "name": "PinAsk",
  "version": "0.2.0",
  "description": "快捷键冻结页面，点选或框选 UI 元素，分组后记下问题。",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "extension/background.js"
  },
  "action": {
    "default_title": "PinAsk",
    "default_popup": "extension/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["overlay/pinask.js", "extension/content.js"],
      "css": ["overlay/pinask.css"],
      "run_at": "document_idle"
    }
  ]
}
